# ملف المتغيرات البيئية
# انسخ هذا الملف إلى .env واملأ القيم

# ============================================
# إعدادات الاتصال
# ============================================
PRINT_PORT=9876
PRINT_HOST=localhost

# ============================================
# إعدادات الطابعة
# ============================================
# اسم الطابعة الافتراضية (اتركها فارغة للطابعة الافتراضية للنظام)
DEFAULT_PRINTER=

# حجم الورق: A4, Letter, 80mm
PAPER_SIZE=A4

# ============================================
# إعدادات الطابعات الحرارية
# ============================================
# قص الورق تلقائيًا: true, false
AUTO_CUT=true

# فتح درج النقود: true, false
OPEN_CASH_DRAWER=false

# عدد النسخ الافتراضي
DEFAULT_COPIES=1

# ============================================
# إعدادات السجلات
# ============================================
# مستوى السجل: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# اسم ملف السجل
LOG_FILE=print_agent.log

# ============================================
# إعدادات الأمان
# ============================================
# IPs المسموح لها (افصل بفاصلة)
ALLOWED_IPS=127.0.0.1,localhost

# ============================================
# إعدادات متقدمة
# ============================================
# مهلة الانتظار (ثواني)
TIMEOUT=30

# الحد الأقصى لحجم الطباعة (ميجابايت)
MAX_PRINT_SIZE=5

# عدد المحاولات عند الفشل
MAX_RETRIES=3

# ============================================
# أدوات التحويل
# ============================================
# مسار wkhtmltopdf (اتركه فارغًا للبحث التلقائي)
WKHTMLTOPDF_PATH=

# ============================================
# ملاحظات:
# ============================================
# 1. لا تضع مسافات حول علامة =
# 2. القيم النصية لا تحتاج علامات تنصيص
# 3. القيم المنطقية: true أو false (بأحرف صغيرة)
# 4. اترك القيمة فارغة لاستخدام الافتراضي
