.venv/
.venv_new/
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Static and Media (production generated)
staticfiles/
media/uploads/

# Environment files
.env
.env.local
.env.production
.env.*.local

# Secrets - NEVER commit these
*.pem
*.key
secrets/

# Test reports
All_Tests_Report_*.txt
All_Tests_Report_*.json
ERP_Test_Report_*.txt
ERP_Test_Report_*.json

# Cache
.cache/
*.cache

# Coverage
htmlcov/
.tox/
.coverage
.coverage.*
.pytest_cache/
nosetests.xml
coverage.xml
*.cover

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Logs
logs/
*.log

# Backup files
backups/
*.bak
*.backup
*.zip
db.sqlite3.backup_*
*.backup_before_*
*.backup_2*
*.html.backup
*.html.backup_*

# Database backup files - NEVER commit
*.sql.gz
*.dump

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Node (if using frontend build)
node_modules/
npm-debug.log

# Celery
celerybeat-schedule
celerybeat.pid

# Docker
docker-compose.override.yml

# Distribution
dist/

# Docker override (local dev)
docker-compose.override.yml

# deploy.sh output logs
deploy_*.log

# Sensitive reports & local data exports
security_audit_report.json
production_readiness_report.json
backup_demo_data_*.json

# Local data / performance history
migration_data/
perf_history/
