[Unit]
Description=Tony ERP Print Agent (WebSocket Server)
After=network.target gunicorn.service
Wants=gunicorn.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/www/tony_erp
Environment=DJANGO_SETTINGS_MODULE=accountant_pro.settings
Environment=AGENT_PORT=9876
Environment=AGENT_HOST=0.0.0.0
Environment=PYTHONPATH=/var/www/tony_erp
ExecStart=/var/www/tony_erp/venv/bin/python3 /var/www/tony_erp/print_server/agent_linux.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
