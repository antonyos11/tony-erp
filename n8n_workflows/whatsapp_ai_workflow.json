      "typeVersion": 4,
      "position": [690, 300]
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": "gpt-4",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "={{ $node['جلب معلومات المنتجات'].json.system_prompt }}\n\nالمنتجات المتاحة:\n{{ $node['جلب معلومات المنتجات'].json.products.map(p => `- ${p.name}: ${p.description} (السعر: ${p.price})`).join('\\n') }}"
            },
            {
              "role": "user",
              "content": "={{ $json.text?.body }}"
            }
          ]
        },
        "options": {
          "temperature": 0.7,
          "maxTokens": 500
        }
      },
      "id": "ai-response",
      "name": "الذكاء الصناعي - OpenAI",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [910, 300],
      "credentials": {
        "openAiApi": {
          "id": "openai-credentials",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// تحليل رد الـ AI واستخراج المعلومات\nconst aiResponse = $input.item.json.choices[0].message.content;\nconst customerMessage = $node['استقبال رسائل WhatsApp'].json.text?.body || '';\n\n// استخراج المنتجات المذكورة\nconst products = [];\nconst productsList = $node['جلب معلومات المنتجات'].json.products || [];\n\nfor (const product of productsList) {\n  if (aiResponse.includes(product.name) || customerMessage.includes(product.name)) {\n    products.push(product.name);\n  }\n}\n\n// تحديد النية (Intent)\nlet intent = 'inquiry';\nif (customerMessage.match(/اشتري|شراء|طلب|أريد/)) {\n  intent = 'purchase';\n} else if (customerMessage.match(/سعر|كم|تكلفة/)) {\n  intent = 'price_inquiry';\n} else if (customerMessage.match(/متوفر|موجود|عندكم/)) {\n  intent = 'availability_check';\n} else if (customerMessage.match(/شكوى|مشكلة|عطل/)) {\n  intent = 'complaint';\n}\n\n// تحليل المشاعر\nlet sentiment = 'neutral';\nif (aiResponse.match(/رائع|ممتاز|شكراً|جيد/) || customerMessage.match(/شكراً|ممتاز|رائع/)) {\n  sentiment = 'positive';\n} else if (customerMessage.match(/سيء|غالي|لا يعجبني|مشكلة/)) {\n  sentiment = 'negative';\n}\n\n// حساب احتمالية التحويل\nlet conversionScore = 0.3; // افتراضي\nif (intent === 'purchase') conversionScore = 0.9;\nelse if (intent === 'price_inquiry') conversionScore = 0.6;\nelse if (intent === 'availability_check') conversionScore = 0.7;\nelse if (sentiment === 'positive') conversionScore = 0.5;\n\nreturn {\n  json: {\n    ai_response: aiResponse,\n    intent: intent,\n    products: products,\n    sentiment: sentiment,\n    conversion_score: conversionScore,\n    conversation_id: $node['حفظ الرسالة في ERP'].json.conversation_id,\n    customer_phone: $node['استقبال رسائل WhatsApp'].json.from\n  }\n};"
      },
      "id": "analyze-response",
      "name": "تحليل الرد",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1130, 300]
    },
    {
