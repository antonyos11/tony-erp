            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $node['تحليل الرد'].json.customer_phone }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"{{ $node['تحليل الرد'].json.ai_response }}\"\n  }\n}",
        "options": {}
      },
