# ===============================================================================
# Tony ERP - ملف الإعدادات البيئية
# ===============================================================================
# انسخ هذا الملف إلى .env وقم بتعديل القيم حسب بيئة العمل

# =============================================================================
# إعدادات Django الأساسية
# =============================================================================

# مفتاح التشفير الآمن (إلزامي - REQUIRED!)
# Generate new key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# WARNING: Never use the default key in production! System will exit if not set.
DJANGO_SECRET_KEY=your-secret-key-here-change-this-immediately

# وضع التطوير (1 للتطوير، 0 للإنتاج)
# WARNING: NEVER use DEBUG=1 in production!
# Default is now 0 (False) for security
DEBUG=1

# البيئة الحالية (development/production/staging)
ENVIRONMENT=development

# المضيفات المسموح لها (comma separated)
# For development: localhost,127.0.0.1,*
# For production: yourdomain.com,192.168.1.50
# WARNING: Avoid using * in production for security!
ALLOWED_HOSTS=localhost,127.0.0.1,*

# اللغة والمنطقة الزمنية
LANGUAGE_CODE=ar
TIME_ZONE=Africa/Cairo

# =============================================================================
# إعدادات قاعدة البيانات
# =============================================================================

# نوع قاعدة البيانات (sqlite, postgresql, mysql)
DB_ENGINE=sqlite

# للـ SQLite (افتراضي للتطوير)
# لا تحتاج إعدادات إضافية

# للـ PostgreSQL (موصى به للإنتاج)
# DATABASE_URL=postgresql://tony:secret@db:5432/tony_erb
POSTGRES_DB=tony_erb
POSTGRES_USER=tony
# ⚠️ غيّر كلمة المرور فوراً في الإنتاج!
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432

# للـ MySQL (بديل)
# MYSQL_DB=tony_erb
# MYSQL_USER=root
# MYSQL_PASSWORD=secret
# MYSQL_HOST=db
# MYSQL_PORT=3306

# =============================================================================
# إعدادات Redis و Celery
# =============================================================================

# عنوان خادم Redis (للذاكرة المؤقتة والمهام)
REDIS_URL=redis://redis:6379/1

# إعدادات Celery للمهام الخلفية
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# =============================================================================
# إعدادات الأمان والمصادقة
# =============================================================================

# مفتاح JWT للـ API
JWT_SECRET_KEY=jwt-secret-change-this-in-production

# مدة صلاحية رموز الوصول (بالدقائق)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60

# مدة صلاحية رموز التحديث (بالأيام)
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# مدة الجلسة (بالثواني)
SESSION_COOKIE_AGE=3600

# =============================================================================
# إعدادات البريد الإلكتروني
# =============================================================================

# خدمة البريد (console للتطوير، smtp للإنتاج)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# إعدادات SMTP (للإنتاج)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_FROM=noreply@yourcompany.com

# =============================================================================
# إعدادات المدفوعات والنسخ الاحتياطي
# =============================================================================

# تفعيل النسخ الاحتياطي التلقائي
AUTO_BACKUP_ENABLED=1

# ساعة النسخ الاحتياطي اليومي (0-23)
BACKUP_SCHEDULE_HOUR=2

# مدة الاحتفاظ بالنسخ الاحتياطية (بالأيام)
BACKUP_RETENTION_DAYS=30

# =============================================================================
# إعدادات الملفات والرفع
# =============================================================================

# الحد الأقصى لحجم الملف المرفوع (بالميجابايت)
MAX_UPLOAD_SIZE_MB=10

# أنواع الملفات المسموحة (مفصولة بفاصلة)
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,jpg,jpeg,png

# =============================================================================
# إعدادات الشبكة المحلية
# =============================================================================

# IP الشبكة المحلية (للوصول من أجهزة أخرى)
# استبدل xxx.xxx.xxx.xxx بعنوان IP الفعلي لجهازك
# LOCAL_NETWORK_IP=192.168.1.100

# =============================================================================
# إعدادات المراقبة والأداء
# =============================================================================

# معدل طلبات API (للمستخدمين غير المسجلين)
API_THROTTLE_RATE=100/day

# معدل طلبات API للجوال (للمستخدمين المسجلين)
API_MOBILE_THROTTLE_RATE=1000/day

# إعدادات فحص الصحة
# النسبة المئوية القصوى لاستخدام القرص
DISK_USAGE_MAX=90

# الحد الأدنى للذاكرة المتاحة (بالميجابايت)
MEMORY_MIN=100

# =============================================================================
# إعدادات الأمان المتقدم (للإنتاج)
# =============================================================================

# تفعيل HTTPS (للإنتاج فقط - يجب أن يكون 1 في الإنتاج)
SECURE_SSL_REDIRECT=0

# إعدادات HSTS (HTTP Strict Transport Security) - للإنتاج فقط
# مدة HSTS بالثواني (31536000 = سنة واحدة - موصى به للإنتاج)
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0

# بريد المشرف لاستقبال إشعارات الأخطاء في الإنتاج
ADMIN_EMAIL=admin@tony-erp.com

# الحد الأقصى لاتصالات Redis المتزامنة (للإنتاج)
REDIS_MAX_CONNECTIONS=50

# مدة اتصال قاعدة البيانات (بالثواني - للإنتاج مع PostgreSQL)
DB_CONN_MAX_AGE=600

# ============================================================
# إعدادات الإنتاج مع Docker
# ============================================================
# لاستخدام إعدادات الإنتاج:
# DJANGO_SETTINGS_MODULE=accountant_pro.settings_production

# ملاحظة مهمة: لتفعيل إعدادات الأمان الكاملة في الإنتاج:
# 1. اضبط DEBUG=0
# 2. اضبط SECURE_SSL_REDIRECT=1
# 3. اضبط SECURE_HSTS_SECONDS=31536000
# 4. تأكد من وجود شهادة SSL صالحة
# 5. استخدم PostgreSQL بدلاً من SQLite
# 6. فعّل Redis للكاش والجلسات
# عند DEBUG=0 يتم تفعيل تلقائياً:
#   - SESSION_COOKIE_SECURE=True
#   - CSRF_COOKIE_SECURE=True
#   - SECURE_CONTENT_TYPE_NOSNIFF=True
#   - SECURE_BROWSER_XSS_FILTER=True

# =============================================================================
# إعدادات Docker (عند استخدام Docker)
# =============================================================================

# معرف المستخدم (لتجنب مشاكل الصلاحيات)
PUID=1000
PGID=1000

# =============================================================================
# إعدادات التطوير (اختيارية)
# =============================================================================

# عرض لافتة الترحيب في وضع التطوير
SHOW_WELCOME_BANNER=1

# تفعيل شريط التطوير Django Debug Toolbar
ENABLE_DEBUG_TOOLBAR=1

# =============================================================================
# ملاحظات مهمة
# =============================================================================
# 
# أمان:
#    - غيّر DJANGO_SECRET_KEY و JWT_SECRET_KEY في الإنتاج
#    - استخدم كلمات مرور قوية لقاعدة البيانات
#    - لا تشارك هذا الملف مع أحد
# 
# قواعد البيانات:
#    - SQLite: سهل للتطوير والاختبار
#    - PostgreSQL: الأفضل للإنتاج
#    - MySQL: بديل مقبول
# 
# الشبكة المحلية:
#    - للوصول من أجهزة أخرى، أضف IP جهازك إلى ALLOWED_HOSTS
#    - تأكد من فتح البورت 8000 في الجدار الناري
# 
# Docker:
#    - استخدم start_docker.bat أو start_docker.sh
#    - ستتم إدارة المنافذ تلقائياً
# 
# ===============================================================================