# Coverage.py configuration for Tony ERP
# Target: 80% coverage for critical modules, 70% overall

[run]
branch = True
source = .
omit = 
    */migrations/*
    */tests/*
    */test_*.py
    */venv/*
    */.venv/*
    */virtualenv/*
    */site-packages/*
    */node_modules/*
    manage.py
    */wsgi.py
    */asgi.py
    */settings/*.py
    */settings.py
    */__pycache__/*
    */static/*
    */templates/*

[report]
# Overall target: 70%
# Critical modules (accounting, sales, inventory, production) target: 80%
fail_under = 70
show_missing = True
skip_covered = False
precision = 2

exclude_lines =
    # Standard pragma
    pragma: no cover
    
    # Don't complain about missing debug-only code
    def __repr__
    if self\.debug
    if settings\.DEBUG
    
    # Don't complain if tests don't hit defensive assertion code
    raise AssertionError
    raise NotImplementedError
    
    # Don't complain if non-runnable code isn't run
    if 0:
    if False:
    if __name__ == .__main__.:
    
    # Type checking
    if TYPE_CHECKING:
    @overload
    
    # Abstract methods
    @abc.abstractmethod
    @abstractmethod
    
    # Deprecated code
    @deprecated
    warnings.warn

# Show line numbers for missing coverage
partial_branches =
    pragma: no branch

[xml]
output = coverage.xml

[html]
directory = htmlcov
title = Tony ERP Test Coverage Report

[paths]
source =
    .
    */site-packages/

# ============================================================================
# Critical Modules - Target 80% Coverage
# ============================================================================
# Priority modules that MUST have high coverage:
# - accounting/ (financial integrity)
# - sales/ (revenue tracking)
# - inventory/ (stock management)
# - production/ (manufacturing)
# - purchases/ (procurement)
# - api/ (external integrations)

