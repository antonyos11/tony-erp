                {'name': _('طلبات الخدمات'), 'url': 'home_services:request_list', 'permission': 'view'},
                {'name': _('فئات الصيانة'), 'url': 'home_services:maintenance_category_list', 'permission': 'view'},
                {'name': _('باقات النظافة'), 'url': 'home_services:cleaning_package_list', 'permission': 'view'},
                {'name': _('إعدادات الخدمات'), 'url': 'home_services:settings', 'permission': 'change'},
                {'name': _('تقارير الخدمات'), 'url': 'home_services:reports', 'permission': 'view'},
