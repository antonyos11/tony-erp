        'ecommerce': {
            'name': _('المتجر الإلكتروني'),
            'icon': 'bi-shop',
            'perm_module': 'ecommerce',
            'permissions': ['view', 'add', 'change'],
            'items': [
                {'type': 'header', 'name': _('لوحة التحكم')},
                {'name': _('لوحة تحكم المتجر'), 'url': 'ecommerce:admin_dashboard', 'permission': 'view'},
                {'type': 'divider'},
                {'type': 'header', 'name': _('إدارة المتجر')},
                {'name': _('الطلبات'), 'url': 'ecommerce:admin_orders', 'permission': 'view'},
                {'name': _('المنتجات'), 'url': 'ecommerce:admin_products', 'permission': 'view'},
                {'name': _('التصنيفات'), 'url': 'ecommerce:admin_categories', 'permission': 'view'},
                {'name': _('التقييمات'), 'url': 'ecommerce:admin_reviews', 'permission': 'view'},
                {'name': _('الكوبونات'), 'url': 'ecommerce:admin_coupons', 'permission': 'view'},
                {'type': 'divider'},
                {'type': 'header', 'name': _('الإعدادات')},
                {'name': _('⚙️ جميع الإعدادات'), 'url': 'ecommerce:admin_settings_menu', 'permission': 'view'},
                {'name': _('إعدادات المتجر'), 'url': 'ecommerce:admin_settings', 'permission': 'change'},
                {'name': _('إعدادات الهيدر'), 'url': 'ecommerce:admin_header_settings', 'permission': 'change'},
                {'name': _('إعدادات الفوتر'), 'url': 'ecommerce:admin_footer_settings', 'permission': 'change'},
                {'name': _('بوابات الدفع'), 'url': 'ecommerce:admin_payment_gateways', 'permission': 'change'},
