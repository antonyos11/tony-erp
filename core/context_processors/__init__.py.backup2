                {'name': _('طلبات تسجيل الضمان'), 'url': 'ecommerce:warranty_registration_list', 'permission': 'view'},
                {'name': _('مطالبات الضمان'), 'url': 'ecommerce:warranty_claim_list', 'permission': 'view'},
                {'type': 'divider'},
                {'type': 'header', 'name': _('🔗 روابط سريعة')},
                {'name': _('عرض المتجر'), 'url': 'ecommerce:store_home', 'permission': 'view'},
