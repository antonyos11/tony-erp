        },
        'maintenance': {
            'name': _('الصيانة'),
            'icon': 'bi-tools',
            'permissions': ['view', 'add', 'change'],
            'items': [
                {'name': _('لوحة الصيانة'), 'url': 'maintenance:dashboard', 'permission': 'view'},
                {'name': _('الماكينات'), 'url': 'maintenance:machine_list', 'permission': 'view'},
                {'name': _('قطع الغيار'), 'url': 'maintenance:spare_part_list', 'permission': 'view'},
                {'name': _('طلبات الصيانة'), 'url': 'maintenance:maintenance_request_list', 'permission': 'view'},
                {'name': _('جدولة الصيانة'), 'url': 'maintenance:maintenance_schedule_list', 'permission': 'view'},
                {'name': _('سجلات الصيانة'), 'url': 'maintenance:maintenance_record_list', 'permission': 'view'},
            ]
        },
    }

    # فحص صلاحيات المستخدم لكل وحدة
    from django.urls import reverse, NoReverseMatch
    current_path = getattr(request, 'path', '')
    current_view_name = ''
    try:
        if hasattr(request, 'resolver_match') and request.resolver_match:
            current_view_name = request.resolver_match.view_name or ''
    except Exception:
        current_view_name = ''

    def _has_perm_mod_or_django(mod_key: str, action: str, perm_mod: str) -> bool:
        try:
            if getattr(request.user, 'is_superuser', False):
                return True
        except Exception:
            pass
        has_mod = False
        try:
            has_mod = request.user.has_module_permission(perm_mod, action)
        except Exception:
            has_mod = False
        if not has_mod and perm_mod == 'purchases':
            try:
                if action == 'view':
                    return (
                        has_mod
                        or request.user.has_perm('purchases.view_purchaseorder')
                        or request.user.has_perm('purchases.view_purchasebill')
                    )
                if action == 'add':
                    return (
                        has_mod
                        or request.user.has_perm('purchases.add_purchaseorder')
                        or request.user.has_perm('purchases.add_purchasebill')
                    )
                if action == 'change':
                    return (
                        has_mod
                        or request.user.has_perm('purchases.change_purchaseorder')
                        or request.user.has_perm('purchases.change_purchasebill')
                    )
            except Exception:
                return has_mod
        return has_mod

    show_all = getattr(request.user, 'is_superuser', False) or getattr(settings, 'UI_SHOW_ALL_MODULES', False)

    for module_key, module_config in modules_config.items():
        perm_module = module_config.get('perm_module', module_key)
        has_access = bool(show_all)
        accessible_items = []
        module_active = False

        # فحص إذا كان المستخدم له أي صلاحية في هذه الوحدة
        if not has_access:
            for permission in module_config['permissions']:
                if _has_perm_mod_or_django(module_key, permission, perm_module):
                    has_access = True
                    break

        # إذا كان له صلاحية، فحص العناصر الفرعية
        if has_access:
            for item in module_config['items']:
                # السماح بعناصر الرأس والفواصل بدون صلاحية
                if item.get('type') in {'header', 'divider'}:
                    accessible_items.append(item)
                    continue
                # عناصر الروابط تتحقق من صلاحية محددة (أو تُعرض للجميع إذا show_all)
                allowed = bool(show_all)
                resource_key = item.get('resource')
                action_key = item.get('permission', 'view')
                if not allowed:
                    if resource_key:
                        try:
                            allowed = request.user.has_resource_permission(perm_module, resource_key, action_key)
                        except Exception:
                            allowed = False
                        if not allowed:
                            allowed = _has_perm_mod_or_django(module_key, action_key, perm_module)
                    else:
                        allowed = _has_perm_mod_or_django(module_key, action_key, perm_module)
                # استثناء عملي: عرض قائمة أوامر الشراء لمن لديه صلاحية الإضافة فقط (بدون عرض عام)
                if not allowed and module_key == 'purchases' and item.get('url') == 'purchases:po_list':
                    try:
                        allowed = request.user.has_module_permission('purchases', 'add') or request.user.has_perm('purchases.add_purchaseorder')
                    except Exception:
                        allowed = False
                if allowed:
                    item_active = False
                    if 'url' in item:
                        raw_url = item['url']
                        if not raw_url.startswith('/'):
                            try:
                                resolved = reverse(raw_url)
                            except NoReverseMatch:
                                resolved = ''
                        else:
                            resolved = raw_url
                        def _norm(p):
                            if not p:
                                return ''
                            return p.rstrip('/') or '/'
                        norm_current = _norm(current_path)
                        norm_resolved = _norm(resolved)
                        if norm_resolved and norm_current == norm_resolved:
                            item_active = True
                        if not item_active and not raw_url.startswith('/') and current_view_name == raw_url:
                            item_active = True
                    if item_active:
                        item['active'] = True
                        module_active = True
                    accessible_items.append(item)

        visible_links = [i for i in accessible_items if 'url' in i]
        if visible_links:
            permissions[module_key] = {
                'name': module_config['name'],
                'icon': module_config['icon'],
                'items': accessible_items,
                'active': module_active,
            }

    return {
        'user_modules': permissions,
        'has_any_permissions': bool(permissions),
    }
