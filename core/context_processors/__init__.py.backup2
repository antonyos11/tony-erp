"""
Context processors للنظام - Tony ERB
"""

import os
from datetime import datetime, timedelta
from django.utils.translation import gettext_lazy as _
from django.conf import settings


def _resolve_ui_new_flag(request, settings):
    """تحديد هل سيتم تفعيل الواجهة الجديدة."""
    try:
        ui_param = request.GET.get('ui') if hasattr(request, 'GET') else None
        if ui_param in ('new', 'old'):
            request.session['UI_NEW'] = (ui_param == 'new')
            return ui_param == 'new'
        if 'UI_NEW' in request.session:
            return bool(request.session.get('UI_NEW'))
        return bool(getattr(settings, 'UI_NEW_DEFAULT', False))
    except Exception:
        return bool(getattr(settings, 'UI_NEW_DEFAULT', False))


_attention_cache = {'value': 0, 'ts': None}
def _purchase_orders_attention_count():
    from purchases.models import PurchaseOrder
    from datetime import date
    now = datetime.utcnow()
    if _attention_cache['ts'] and (now - _attention_cache['ts']) < timedelta(seconds=60):
        return _attention_cache['value']
    today = date.today()
    qs = PurchaseOrder.objects.filter(status__in=['confirmed', 'partial']).only('id', 'status', 'expected_date')
    count = 0
    for po in qs:
        if po.status == 'partial' or (po.expected_date and po.expected_date < today and po.status != 'partial'):
            count += 1
    _attention_cache['value'] = count
    _attention_cache['ts'] = now
    return count


_pending_cache = {'value': 0, 'ts': None}
def _pending_purchase_orders_count():
    from purchases.models import PurchaseOrder
    now = datetime.utcnow()
    if _pending_cache['ts'] and (now - _pending_cache['ts']) < timedelta(seconds=60):
        return _pending_cache['value']
    qs = PurchaseOrder.objects.filter(status__in=['draft', 'confirmed', 'partial']).select_related('bill').only('id', 'status', 'bill_id')
    count = 0
    for po in qs:
        bill = getattr(po, 'bill', None)
        if not bill or not getattr(bill, 'posted', False):
            count += 1
    _pending_cache['value'] = count
    _pending_cache['ts'] = now
    return count


_unposted_cache = {'value': 0, 'ts': None}
def _unposted_journal_entries_count():
    from accounting.models import JournalEntry
    now = datetime.utcnow()
    if _unposted_cache['ts'] and (now - _unposted_cache['ts']) < timedelta(seconds=60):
        return _unposted_cache['value']
    count = JournalEntry.objects.filter(is_posted=False).count()
    _unposted_cache['value'] = count
    _unposted_cache['ts'] = now
    return count


def system_info(request):
    """إضافة معلومات النظام للسياق العام"""
    from core.models import Company, AppSettings
    from django.conf import settings

    company = Company.objects.first()
    app_settings = AppSettings.get()

    # ألوان الهوية: من إعدادات التطبيق ثم من متغيرات البيئة عند غيابها
    brand = dict(app_settings.brand_colors or {})
    env_brand = {
        'primary': os.getenv('BRAND_PRIMARY', ''),
        'primary_dark': os.getenv('BRAND_PRIMARY_DARK', ''),
        'primary_light': os.getenv('BRAND_PRIMARY_LIGHT', ''),
        'info': os.getenv('BRAND_INFO', ''),
        'success': os.getenv('BRAND_SUCCESS', ''),
        'warning': os.getenv('BRAND_WARNING', ''),
        'danger': os.getenv('BRAND_DANGER', ''),
    }
    for k, v in env_brand.items():
        if k not in brand and v:
            brand[k] = v
    # نظّف القيم الفارغة
    brand = {k: v for k, v in brand.items() if v}

    # اكتشاف عنوان IP المحلي لعرضه في زر/نافذة المشاركة
    try:
        import socket
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        local_ip = s.getsockname()[0]
        s.close()
    except Exception:
        local_ip = ''

    # منفذ وبروتوكول الطلب الحالي
    try:
        request_port = request.get_port()
    except Exception:
        request_port = os.getenv('PORT', '8000')
    request_scheme = getattr(request, 'scheme', 'http')

    from django.utils import translation
    current_lang = getattr(request, 'LANGUAGE_CODE', translation.get_language())
    ui_new = _resolve_ui_new_flag(request, settings)
    base_context = {
        'SYSTEM_NAME': 'Tony ERB',
        'SYSTEM_VERSION': '2.0',
        'SYSTEM_DESCRIPTION': _('نظام إدارة الأعمال الشامل'),
        'BRAND_COLORS': brand or None,
        'company': company,
        'APP_SETTINGS': app_settings,
        'SERVER_LOCAL_IP': local_ip,
        'REQUEST_PORT': request_port,
        'REQUEST_SCHEME': request_scheme,
        'CURRENT_LANGUAGE_CODE': current_lang,
        'UI_NEW': ui_new,
        'BASE_TEMPLATE': 'base_v2.html' if ui_new else 'base.html',
        'base_template': 'base_v2.html' if ui_new else 'base.html',
        'PURCHASE_ORDERS_ATTENTION_COUNT': (_purchase_orders_attention_count() if (request.user.is_authenticated and request.user.has_perm('purchases.view_purchaseorder')) else None),
        'pending_purchase_orders_count': (_pending_purchase_orders_count() if (request.user.is_authenticated and request.user.has_perm('purchases.view_purchaseorder')) else 0),
        'unposted_journal_entries_count': (
            _unposted_journal_entries_count()
            if (request.user.is_authenticated and (request.user.is_superuser or request.user.has_perm('accounting.view_journalentry')))
            else 0
        ),
    }
    return base_context


