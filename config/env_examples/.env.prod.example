# Production environment template for Tony ERP
# Copy to .env.prod and fill values, then run: docker compose --env-file .env.prod up -d

# Core
DJANGO_SECRET_KEY=
DEBUG=0
ENVIRONMENT=production

# Hosts & CORS
PROD_ALLOWED_HOSTS=example.com,www.example.com,api.example.com
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com,https://app.example.com

# Database (PostgreSQL)
POSTGRES_DB=tony_erb
POSTGRES_USER=tony
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_ENGINE=postgresql
DATABASE_URL=

# Redis
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Security
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=1

# Email (optional)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=
