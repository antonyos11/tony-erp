[Unit]
Description=RITA ERP — نظام إدارة موارد المصنع
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/rita-erp
EnvironmentFile=/var/www/rita-erp/.env
ExecStart=/var/www/rita-erp/venv/bin/gunicorn config.wsgi:application -c gunicorn.conf.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5

# Logging
StandardOutput=append:/var/www/rita-erp/logs/gunicorn_access.log
StandardError=append:/var/www/rita-erp/logs/gunicorn_error.log

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
