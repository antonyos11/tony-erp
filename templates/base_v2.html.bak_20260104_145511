{% load static %}{% load tony_erb_tags %}{% load i18n %}
{% get_current_language as LANGUAGE_CODE %}
<!doctype html>
<html lang="{{ LANGUAGE_CODE }}" dir="{% if LANGUAGE_CODE == 'ar' %}rtl{% else %}ltr{% endif %}" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover">
  <meta name="csrf-token" content="{{ csrf_token }}">
  <title>{% block title %}{{ SYSTEM_NAME }}{% endblock %}</title>
  <script>
    // Apply saved or preferred theme before CSS loads to avoid FOUC
    (function(){try{var saved=localStorage.getItem('theme');var prefersDark=window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches;var theme=saved||(prefersDark?'dark':'light');document.documentElement.setAttribute('data-theme',theme);}catch(e){})();
  </script>
  <link id="bootstrapCoreCss" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap{% if LANGUAGE_CODE == 'ar' %}.rtl{% endif %}.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
  <link href="{% static 'css/design_system.css' %}?v=2" rel="stylesheet">
  <link href="{% static 'css/ui_v2.css' %}?v=21" rel="stylesheet">
  <link href="{% static 'css/enhancements.css' %}?v=1" rel="stylesheet">
  <link href="{% static 'css/neo_theme.css' %}?v=1" rel="stylesheet">
  <link href="{% static 'css/modern_pages.css' %}?v=1" rel="stylesheet">
  <link href="{% static 'css/mobile_responsive.css' %}?v=4" rel="stylesheet">
  <link href="{% static 'css/dashboard_compact.css' %}?v=1" rel="stylesheet">
  <link href="{% static 'css/no_margins.css' %}?v=12" rel="stylesheet">
  <link href="{% static 'css/dropdown_fix.css' %}?v=1" rel="stylesheet">
  {% block extra_css %}{% endblock %}
  <style>
    /* تحسينات سريعة للموبايل: اجعل الشريط الجانبي كدرج يغطي المحتوى فقط عند الطلب */
    @media (max-width: 991.98px){
      body.flyout-open { overflow: hidden; }
      .app-topbar .navbar-nav { gap: .35rem; }
      #globalSearchContainer { display: none !important; }
    }
  /* جداول ونماذج عامة متجاوبة على مستوى النظام */
  .table { vertical-align: middle; }
  .table-wrap, .table-responsive, .responsive-block { overflow-x:auto; -webkit-overflow-scrolling:touch; }
  .responsive-block > table { min-width: 640px; }
  .form-inline-wrap { display:flex; flex-wrap:wrap; gap:.5rem; }
  .form-inline-wrap > * { flex:1 1 200px; }

  /* شريط الاختصارات العلوي - مثبت ومرئي دائماً */
  .quick-actions-wrap { position: sticky; top: 6px; z-index: 100; }
  .quick-actions { background: linear-gradient(120deg, rgba(255,255,255,0.96), rgba(241,245,249,0.96)); border: 1px solid rgba(0,0,0,0.12); border-radius: 16px; padding: 7px 12px; gap: 6px; box-shadow: 0 16px 34px rgba(0,0,0,0.14); }
  [data-theme="dark"] .quick-actions { background: linear-gradient(120deg, rgba(23,30,49,0.94), rgba(15,23,42,0.94)); border-color: rgba(255,255,255,0.18); box-shadow: 0 16px 34px rgba(0,0,0,0.5); }
  .quick-actions .qa-btn { width: 38px; height: 38px; border: none; background: transparent; color: #0f172a; border-radius: 11px; display: inline-flex; align-items: center; justify-content: center; transition: all .2s ease; font-size: 16px; }
  .quick-actions .qa-btn:hover { background: rgba(0,0,0,0.07); color: #0b132b; box-shadow: 0 5px 16px rgba(0,0,0,0.16); }
  [data-theme="dark"] .quick-actions .qa-btn { color: #e2e8f0; }
  [data-theme="dark"] .quick-actions .qa-btn:hover { background: rgba(255,255,255,0.1); color: #fff; }
  .quick-actions .qa-divider { width: 1px; height: 24px; background: rgba(0,0,0,0.12); margin: 0 4px; }
  [data-theme="dark"] .quick-actions .qa-divider { background: rgba(255,255,255,0.18); }
  .quick-actions .qa-user { font-size: 13px; color: #1f2937; padding-inline-start: 10px; font-weight: 700; }
  [data-theme="dark"] .quick-actions .qa-user { color: #e2e8f0; }
  @media (max-width: 991.98px){
    .quick-actions-wrap { position: fixed; top: 10px; inset-inline-end: 12px; transform: scale(0.94); }
    .quick-actions { padding: 6px 10px; gap: 5px; border-radius: 14px; }
    .quick-actions .qa-btn { width: 34px; height: 34px; font-size: 15px; }
  }
  /* إصلاح تراكب القوائم المنسدلة فوق المحتوى */
  .app-topbar { position: sticky; top: 0; z-index: 1000; overflow: visible !important; }
  .navbar .dropdown-menu { z-index: 9999 !important; position: absolute !important; }
  .app-content { position: relative; z-index: 1; }
  </style>
  {# ألوان الهوية الديناميكية #}
  {% if BRAND_COLORS %}
  <style>
    :root {
      {% if BRAND_COLORS.primary %}--primary-color: {{ BRAND_COLORS.primary }};--primary-dark: {{ BRAND_COLORS.primary_dark|default:BRAND_COLORS.primary }};--primary-light: {{ BRAND_COLORS.primary_light|default:BRAND_COLORS.primary }};{% endif %}
      {% if BRAND_COLORS.info %}--info-color: {{ BRAND_COLORS.info }};{% endif %}
      {% if BRAND_COLORS.success %}--success-color: {{ BRAND_COLORS.success }};{% endif %}
      {% if BRAND_COLORS.warning %}--warning-color: {{ BRAND_COLORS.warning }};{% endif %}
      {% if BRAND_COLORS.danger %}--danger-color: {{ BRAND_COLORS.danger }};{% endif %}
    }
  </style>
  {% endif %}
  {% block extra_head %}{% endblock %}
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
</head>
<body class="app-body">
  <div id="django-csrf-token" hidden>{% csrf_token %}</div>
  {% if UI_NEW %}
  <div id="newUiBanner" class="new-ui-banner small text-center">
    <span>{% trans '🔥 أنت الآن تستخدم الواجهة الجديدة التجريبية.' %}</span>
    <a href="/dashboard/ui/old/?next={{ request.path }}" class="ms-2 link-underline link-underline-opacity-0">{% trans 'الرجوع مؤقتاً' %}</a>
    <button type="button" class="btn-close btn-close-white ms-2" aria-label="{% trans 'إغلاق' %}" id="dismissNewUiBanner"></button>
  </div>
  {% endif %}
  {% include 'partials/_sidebar.html' %}
  <div class="app-wrapper">
    <nav class="app-topbar navbar navbar-expand-lg shadow-sm">
      <div class="container-fluid">
        <button class="btn btn-outline-secondary btn-sm me-2 d-lg-none" id="sidebarToggle" aria-label="Toggle sidebar"><i class="bi bi-list"></i></button>
        <div class="d-flex align-items-center ms-auto me-3 quick-actions-wrap">
          <span class="qa-user me-2">{{ user.get_short_name|default:user.username }}</span>
          <div class="quick-actions align-items-center d-flex">
            <button class="qa-btn" data-quick-action="clear-cache" type="button" data-bs-toggle="tooltip" data-bs-placement="bottom" title="مسح الكاش"><i class="bi bi-arrow-repeat"></i></button>
            <button class="qa-btn" data-quick-action="home" type="button" data-bs-toggle="tooltip" data-bs-placement="bottom" title="الصفحة الرئيسية"><i class="bi bi-house-door-fill"></i></button>
            <button class="qa-btn" data-quick-action="track-reps" type="button" data-bs-toggle="tooltip" data-bs-placement="bottom" title="تتبع المناديب"><i class="bi bi-geo-alt-fill"></i></button>
            <button class="qa-btn" data-quick-action="ecommerce" type="button" data-bs-toggle="tooltip" data-bs-placement="bottom" title="المتجر الالكتروني"><i class="bi bi-shop-window"></i></button>
            <button class="qa-btn" data-quick-action="notifications" type="button" data-bs-toggle="tooltip" data-bs-placement="bottom" title="الاشعارات"><i class="bi bi-bell"></i></button>
            <button class="qa-btn" data-quick-action="all-notifications" type="button" data-bs-toggle="tooltip" data-bs-placement="bottom" title="جميع الاشعارات"><i class="bi bi-list-ul"></i></button>
            <button class="qa-btn" data-quick-action="backup" type="button" data-bs-toggle="tooltip" data-bs-placement="bottom" title="تحميل النسخة الاحتياطية"><i class="bi bi-cloud-arrow-down-fill"></i></button>
            <div class="qa-divider" aria-hidden="true"></div>
            <button class="qa-btn" data-quick-action="maintenance" type="button" data-bs-toggle="tooltip" data-bs-placement="bottom" title="صيانة النظام / التحديثات"><i class="bi bi-tools"></i></button>
          </div>
        </div>
        <ul class="navbar-nav ms-auto align-items-center gap-2">
          <li class="nav-item">
            <button id="themeToggle" class="btn btn-sm btn-outline-primary rounded-pill" type="button" aria-label="تبديل الوضع"><i class="bi bi-moon-stars" id="themeIcon"></i></button>
          </li>
          <li class="nav-item">
            <button id="dirToggle" class="btn btn-sm btn-outline-secondary rounded-pill" type="button" aria-label="Toggle Direction" title="RTL/LTR"><i class="bi bi-layout-text-sidebar-reverse"></i></button>
          </li>
          <li class="nav-item">
            <button id="commandPaletteBtn" class="btn btn-sm btn-outline-secondary rounded-pill" type="button" title="Ctrl+K"><i class="bi bi-search"></i></button>
          </li>
          {# Language switcher dropdown #}
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle small" href="#" id="langDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-translate"></i>
              {% if LANGUAGE_CODE == 'ar' %}{% trans 'العربية' %}{% else %}{% trans 'English' %}{% endif %}
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="langDropdown">
              <li>
                <form method="post" action="/i18n/setlang/" class="px-3 py-1">
                  {% csrf_token %}
                  <input type="hidden" name="next" value="{{ request.path }}">
                  <button name="language" value="ar" class="dropdown-item{% if LANGUAGE_CODE == 'ar' %} active{% endif %}" type="submit">{% trans 'العربية' %}</button>
                  <button name="language" value="en" class="dropdown-item{% if LANGUAGE_CODE == 'en' %} active{% endif %}" type="submit">{% trans 'English' %}</button>
                </form>
              </li>
            </ul>
          </li>
          {% if user.is_authenticated and user_showrooms %}
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle small" href="#" id="showroomDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-shop"></i>
              {% if current_showroom %}{{ current_showroom.name }}{% else %}{% trans 'المعرض' %}{% endif %}
            </a>
            <ul class="dropdown-menu dropdown-menu-end small" aria-labelledby="showroomDropdown" style="max-height:300px;overflow:auto;">
              {% for sr in user_showrooms %}
              <li>
                <a class="dropdown-item d-flex justify-content-between align-items-center{% if current_showroom and sr.id == current_showroom.id %} active{% endif %}" href="{{ request.path }}?showroom={{ sr.id }}">
                  <span>{{ sr.name }}</span>
                  {% if current_showroom and sr.id == current_showroom.id %}<i class="bi bi-check2"></i>{% endif %}
                </a>
              </li>
              {% endfor %}
            </ul>
          </li>
          {% endif %}
          {% user_menu %}
        </ul>
        <div class="global-search-wrapper d-none d-md-block" role="search" id="globalSearchContainer">
          <div class="input-group input-group-sm search-box position-relative">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input id="globalSearch" class="form-control" type="search" placeholder="{% trans 'بحث في القوائم...' %}" autocomplete="off" aria-label="{% trans 'بحث' %}">
            <div id="globalSearchResults" class="global-search-results list-group d-none" role="listbox" aria-label="نتائج البحث"></div>
          </div>
        </div>
      </div>
    </nav>
    <main class="app-content py-3" style="margin-right: var(--sidebar-width) !important; margin-left: 0 !important;">
      <div class="layout-container">
      {% if messages %}
        {% for message in messages %}
          <div class="alert alert-{{ message.tags }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        {% endfor %}
      {% endif %}
  {% block content %}{% endblock %}
  </div>
    </main>
  {% include 'includes/footer.html' %}
  </div>
  <!-- Mobile backdrop for sidebar -->
  <div id="sidebarMobileBackdrop" class="sidebar-mobile-backdrop" hidden></div>
  <!-- Back to top button -->
  <button id="backToTop" class="fab no-print" onclick="window.scrollTo({top:0,behavior:'smooth'})" style="opacity:0;pointer-events:none;transition:opacity .3s" title="العودة للأعلى">
    <i class="bi bi-arrow-up"></i>
  </button>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="{% static 'js/csrf.js' %}?v=1"></script>
  <script src="{% static 'js/app_layout.js' %}?v=9"></script>
  <script src="{% static 'js/global_search.js' %}?v=1"></script>
  <script src="{% static 'js/global_ui.js' %}?v=2"></script>
  <script src="{% static 'js/nav.js' %}?v=1"></script>
  <script src="{% static 'js/performance.js' %}?v=1"></script>
  <script>
    (function(){
      const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
      tooltipTriggerList.forEach(el => { try { new bootstrap.Tooltip(el); } catch(e) {} });

      const dashboardUrl = "{% url 'core:dashboard' %}";
      const settingsUrl = "{% url 'core:company_settings' %}";

      const goDashboard = () => { window.location.href = dashboardUrl || '/'; };
      const showToast = (msg, type='secondary') => {
        try {
          const toastContainer = document.createElement('div');
          toastContainer.className = 'toast align-items-center text-bg-'+type+' border-0 position-fixed top-0 end-0 m-3';
          toastContainer.style.zIndex = 2050;
          toastContainer.innerHTML = '<div class="d-flex"><div class="toast-body">'+msg+'</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>';
          document.body.appendChild(toastContainer);
          const toast = new bootstrap.Toast(toastContainer, { delay: 3000 });
          toast.show();
          toastContainer.addEventListener('hidden.bs.toast', () => toastContainer.remove());
        } catch(e) {}
      };
      const getCookie = (name) => {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        if (parts.length === 2) return parts.pop().split(';').shift();
      };
      const clearCache = () => {
        if ('caches' in window) {
          caches.keys().then(names => { names.forEach(name => { caches.delete(name); }); });
        }
        localStorage.clear();
        sessionStorage.clear();
        showToast('تم مسح الكاش بنجاح! جاري إعادة التحميل...', 'success');
        setTimeout(() => { location.reload(true); }, 1200);
      };
      const notify = () => {
        const alerts = document.querySelectorAll('.alert');
        if (alerts.length) { alerts[0].scrollIntoView({behavior:'smooth',block:'center'}); alerts[0].classList.add('shadow'); return; }
        showToast('لا توجد إشعارات جديدة', 'info');
      };
      const quickActions = {
        'clear-cache': () => clearCache(),
        home: () => goDashboard(),
        'track-reps': () => { window.location.href = '/sales/location/tracking/'; },
        ecommerce: () => { window.location.href = '/ecommerce/'; },
        notifications: () => notify(),
        'all-notifications': () => { window.location.href = '/notifications/'; },
        backup: async () => {
          try {
            showToast('جاري إنشاء النسخة الاحتياطية...', 'info');
            const resp = await fetch('/api/system/backup/', {
              method: 'POST',
              headers: {
                'X-CSRFToken': document.querySelector('[name=csrfmiddlewaretoken]')?.value || getCookie('csrftoken'),
                'Content-Type': 'application/json'
              }
            });
            const data = await resp.json();
            if (data.success && data.download_url) {
              showToast('تم إنشاء النسخة الاحتياطية! جاري التنزيل...', 'success');
              window.location.href = data.download_url;
            } else {
              showToast('فشل إنشاء النسخة الاحتياطية: ' + (data.message || 'خطأ'), 'danger');
            }
          } catch(e) {
            showToast('خطأ: ' + e.message, 'danger');
          }
        },
        maintenance: () => { window.location.href = settingsUrl; },
      };

      document.querySelectorAll('[data-quick-action]').forEach(btn => {
        btn.addEventListener('click', () => {
          const action = btn.getAttribute('data-quick-action');
          const fn = quickActions[action];
          if (typeof fn === 'function') { fn(); }
        });
      });
    })();
  </script>
  {% block extra_js %}{% endblock %}
  
  <!-- AI Chat Widget -->
  {% include "ai_assistant/chat_widget.html" %}
</body>
</html>


