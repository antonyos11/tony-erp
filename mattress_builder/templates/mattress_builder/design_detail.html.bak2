{% extends 'ecommerce/store_base_new.html' %}
{% load static i18n %}

{% block title %}تفاصيل التصميم - {{ store_settings.store_name|default:"Tony Store" }}{% endblock %}

{% block extra_css %}
<style>
    .detail-hero {
        background: linear-gradient(135deg, var(--primary, #1B2A4A) 0%, #2c3e6b 100%);
        padding: 2rem 0; color: white;
    }
    .info-card {
        border: 1px solid #e9ecef; border-radius: 1rem;
        background: white; overflow: hidden; height: 100%;
    }
    .info-card-header {
        padding: 1rem 1.25rem; border-bottom: 1px solid #e9ecef;
        font-weight: 700; font-size: 1.05rem;
        display: flex; align-items: center; gap: 0.5rem;
        color: var(--primary, #1B2A4A);
    }
    .info-card-body { padding: 1.25rem; }
    .info-row {
        display: flex; justify-content: space-between;
        padding: 0.6rem 0; border-bottom: 1px solid #f8f9fa;
        font-size: 0.92rem;
    }
    .info-row:last-child { border: none; }
    .info-row .label { color: #6c757d; }
    .info-row .value { font-weight: 600; }

    .price-card { border: 2px solid var(--primary, #1B2A4A) !important; }
    .price-card .info-card-header { background: var(--primary, #1B2A4A); color: white; }
    .total-row {
        display: flex; justify-content: space-between;
        padding-top: 0.75rem; margin-top: 0.5rem;
        border-top: 2px solid #e9ecef;
        font-size: 1.4rem; font-weight: 800;
    }
    .total-row .price { color: var(--secondary, #C8A962); }

    .component-item {
        display: flex; justify-content: space-between; align-items: center;
        padding: 0.85rem 1rem; border-bottom: 1px solid #f1f3f5;
        font-size: 0.92rem;
    }
    .component-item:last-child { border: none; }
    .component-item .name { font-weight: 600; color: #212529; }
    .component-item .desc { font-size: 0.8rem; color: #6c757d; }
    .component-item .price { font-weight: 700; color: var(--secondary, #C8A962); white-space: nowrap; }

    .status-badge-lg {
        display: inline-block; padding: 0.4rem 1rem;
        border-radius: 50px; font-size: 0.85rem; font-weight: 600;
    }
    .status-draft { background: #f1f3f5; color: #495057; }
    .status-in_review { background: #dbeafe; color: #1e40af; }
    .status-approved { background: #d1fae5; color: #065f46; }
    .status-rejected { background: #fee2e2; color: #991b1b; }
    .status-in_production { background: #fef3c7; color: #92400e; }
    .status-ready { background: #ede9fe; color: #5b21b6; }
    .status-completed { background: #d1fae5; color: #065f46; }
</style>
{% endblock %}

{% block content %}
<!-- Hero -->
<div class="detail-hero">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2" style="--bs-breadcrumb-divider: '>';">
                <li class="breadcrumb-item"><a href="{% url 'ecommerce:store_home' %}" class="text-white-50">الرئيسية</a></li>
                <li class="breadcrumb-item"><a href="{% url 'ecommerce:mattress_builder:my_designs' %}" class="text-white-50">تصاميمي</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">تفاصيل التصميم</li>
            </ol>
        </nav>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h1 class="fw-bold mb-0" id="designTitle">تفاصيل التصميم</h1>
            <span id="statusBadge" class="status-badge-lg"></span>
        </div>
    </div>
</div>

<div class="container py-4" id="app">
    <div class="row g-4 mb-4">
        <!-- Size Info -->
        <div class="col-md-6">
            <div class="info-card">
                <div class="info-card-header"><i class="bi bi-rulers"></i> معلومات المقاس</div>
                <div class="info-card-body">
                    <div class="info-row">
                        <span class="label">المقاس:</span>
                        <span class="value">[[ design.size?.name ]]</span>
                    </div>
                    <div class="info-row">
                        <span class="label">الأبعاد:</span>
                        <span class="value">[[ design.size?.width ]] × [[ design.size?.length ]] سم</span>
                    </div>
                    <div class="info-row">
                        <span class="label">السعر الأساسي:</span>
                        <span class="value" style="color:var(--secondary,#C8A962);">[[ design.size?.base_price ]] ج.م</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Price Summary -->
        <div class="col-md-6">
            <div class="info-card price-card">
                <div class="info-card-header"><i class="bi bi-receipt"></i> ملخص السعر</div>
                <div class="info-card-body">
                    <div class="info-row">
                        <span class="label">سعر الأساس:</span>
                        <span class="value">[[ design.size?.base_price ]] ج.م</span>
                    </div>
                    <div class="info-row">
                        <span class="label">المكونات:</span>
                        <span class="value">[[ componentsTotal ]] ج.م</span>
                    </div>
                    <div class="total-row">
                        <span>الإجمالي</span>
                        <span class="price">[[ design.total_price ]] ج.م</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Components -->
    <div class="info-card mb-4">
        <div class="info-card-header"><i class="bi bi-layers"></i> المكونات المختارة</div>
        <div>
            <div class="component-item" v-for="comp in design.components" :key="comp.id">
                <div>
                    <div class="name">[[ comp.name ]]</div>
                    <div class="desc" v-if="comp.description">[[ comp.description ]]</div>
                </div>
                <div class="price">[[ comp.price ]] ج.م</div>
            </div>
            <div v-if="!design.components || design.components.length === 0" class="text-center text-muted p-4">
                لا توجد مكونات
            </div>
        </div>
    </div>

    <!-- Notes -->
    <div v-if="design.notes || design.rejection_reason" class="info-card mb-4">
        <div class="info-card-header"><i class="bi bi-chat-square-text"></i> ملاحظات</div>
        <div class="info-card-body">
            <div v-if="design.notes" class="mb-3">
                <div class="fw-bold mb-1" style="color:#495057;">ملاحظات:</div>
                <p class="text-muted mb-0">[[ design.notes ]]</p>
            </div>
            <div v-if="design.rejection_reason" class="alert alert-danger mb-0">
                <div class="fw-bold mb-1"><i class="bi bi-exclamation-triangle ms-1"></i> سبب الرفض:</div>
                <p class="mb-0">[[ design.rejection_reason ]]</p>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="d-flex gap-3">
        <a href="{% url 'ecommerce:mattress_builder:my_designs' %}" class="btn btn-lg btn-outline-secondary flex-fill fw-bold">
            <i class="bi bi-arrow-right ms-1"></i> العودة للقائمة
        </a>
        <a v-if="design.status === 'draft'" :href="'/ecommerce/mattress-builder/builder/?edit=' + design.id"
           class="btn btn-lg flex-fill fw-bold" style="background:var(--primary,#1B2A4A);color:white;">
            <i class="bi bi-pencil-square ms-1"></i> تعديل التصميم
        </a>
    </div>
</div>
{% endblock %}

{% block extra_js %}
<script src="https://cdn.jsdelivr.net/npm/vue@3/dist/vue.global.prod.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script>
const { createApp } = Vue;
createApp({
    delimiters: ['[[', ']]'],
    data() {
        return {
            design: {
                id: '{{ design.id }}',
                name: '{{ design.name }}',
                status: '{{ design.status }}',
                notes: '{{ design.notes|default:""|escapejs }}',
                rejection_reason: '{{ design.rejection_reason|default:""|escapejs }}',
                total_price: '{{ design.total_price|default:0 }}',
                size: null,
                components: []
            }
        }
    },
    computed: {
        componentsTotal() {
            if (!this.design.components) return 0;
            return this.design.components.reduce((s, c) => s + parseFloat(c.price || 0), 0).toFixed(2);
        }
    },
    methods: {
        async loadDesign() {
            try {
                const res = await axios.get(`/ecommerce/mattress-builder/api/designs/${this.design.id}/`);
                this.design = res.data;
                document.getElementById('designTitle').textContent = this.design.name;
                const badge = document.getElementById('statusBadge');
                badge.textContent = this.getStatusLabel(this.design.status);
                badge.className = 'status-badge-lg status-' + this.design.status;
            } catch (e) { console.error('خطأ:', e); }
        },
        getStatusLabel(s) {
            return { 'draft':'مسودة','in_review':'قيد المراجعة','approved':'معتمد','rejected':'مرفوض','in_production':'قيد الإنتاج','ready':'جاهز','completed':'مكتمل' }[s] || s;
        },
        getStatusClass(s) {
            return { 'draft':'bg-secondary text-white','in_review':'bg-info text-dark','approved':'bg-success text-white','rejected':'bg-danger text-white','in_production':'bg-warning text-dark','ready':'bg-primary text-white','completed':'bg-success text-white' }[s] || 'bg-secondary text-white';
        }
    },
    mounted() { this.loadDesign(); }
}).mount('#app');
</script>
{% endblock %}
